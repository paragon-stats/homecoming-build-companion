{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "check-text-files",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["run", "scripts/dev/check-text-files.cs"]
    },
    {
      "name": "check-encoding",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["run", "scripts/dev/check-encoding.cs", "--", "--staged"]
    },
    {
      "name": "check-coverage-exclusions",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["run", "scripts/dev/check-coverage-exclusions.cs", "--", "--staged"]
    },
    {
      "name": "check-git-signing",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["run", "scripts/dev/check-git-signing.cs"]
    },
    {
      "name": "check-banned-words",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["run", "scripts/dev/check-banned-words.cs", "--", "--staged"]
    },
    {
      "name": "dotnet-format",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["format", "--verify-no-changes", "--severity", "error"]
    },
    {
      "name": "check-commit-message",
      "group": "commit-msg",
      "command": "bash",
      "args": ["-c", "MESSAGE_FILE=\"$1\" bash scripts/git/check-commit-message.sh", "check-commit-message", "${args}"]
    },
    {
      "name": "check-banned-words-push",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["run", "scripts/dev/check-banned-words.cs"]
    },
    {
      "name": "build",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["build", "--nologo"]
    },
    {
      "name": "super-linter",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["run", "scripts/dev/run-super-linter.cs"]
    },
    {
      "name": "test",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["test", "--no-build"]
    }
  ]
}
