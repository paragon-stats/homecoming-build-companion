{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "dotnet-format",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["format", "--verify-no-changes", "--severity", "error"]
    },
    {
      "name": "check-encoding",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["run", "scripts/dev/check-encoding.cs"]
    },
    {
      "name": "check-banned-words",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["run", "scripts/dev/check-banned-words.cs"]
    },
    {
      "name": "check-coverage-exclusions",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["run", "scripts/dev/check-coverage-exclusions.cs", "--", "--staged"]
    },
    {
      "name": "python-pre-commit",
      "group": "pre-commit",
      "command": "sh",
      "args": ["scripts/dev/hook-python.sh", "-m", "pre_commit", "run", "--hook-stage", "pre-commit"]
    },
    {
      "name": "check-commit-message",
      "group": "commit-msg",
      "command": "sh",
      "args": ["scripts/dev/hook-python.sh", "scripts/testing/hooks/check_commit_message.py", "${args}"]
    },
    {
      "name": "build",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["build", "--nologo"]
    },
    {
      "name": "test",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["test", "--no-build"]
    },
    {
      "name": "check-banned-words-push",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["run", "scripts/dev/check-banned-words.cs"]
    }
  ]
}
