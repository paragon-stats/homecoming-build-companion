#!/bin/sh
# Plain script: does not source .husky/_/husky.sh, so a fresh worktree needs no generated files.
# core.hooksPath=.husky is set once per repository: dotnet tool restore && dotnet husky install
# The hook restores no tools; without them dotnet husky fails and names the restore command.
# --quiet drops Husky's banner and separator lines; run the same line without it to see them.
dotnet husky run --quiet --group pre-commit
