    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Mutant Theme Costume Sets",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Both costume sets include tintable costume pieces, a new feature that allows you to create unique glows for individual costume pieces."
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Secondary Mutation Power",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Tap into the incredible potential locked within your DNA. Secondary Mutation allows your character to mutate itself for amazing, unexpected results. Charge into battle with new abilities. Be careful, they may help your foes more than you. There is a chance this power can backfire and turn you into a Rikti monkey. Secondary Mutation is available every 20 minutes and is not affected by recharge buffs. Its effects include:"
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Secondary Mutation Power",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Acute senses"
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Secondary Mutation Power",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Tough hide"
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Secondary Mutation Power",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Pain tolerance"
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Secondary Mutation Power",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Quick reflexes"
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Secondary Mutation Power",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Heightened speed"
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Character Emotes",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Showoff (/em showoff)"
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Character Emotes",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Growl (/em growl)"
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Costume Change Emotes",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Activate the following mutant-themed costume change emotes using the costume change interface, selectable from the main Menu."
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Costume Change Emotes",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Energy Morph (/cce # CCEnergyMorph)"
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Costume Change Emotes",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Rapid Boil (/cce # CCRapidBoil)"
    },
    {
      "category": "Super Booster V: Mutant",
      "subsection": "Costume Change Emotes",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Dimensional Shift (/cce # CCDiminsionalShift)"
    },
    {
      "category": "COMBINED",
      "subsection": "General",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Arachnos Heavy Blasters will no longer immediately run out of endurance."
    },
    {
      "category": "COMBINED",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug in all Police Band/Broker 'rescue' missions, where the boss guarding the rescue NPC would be named 'BOSS_DISPLAYNAME'"
    },
    {
      "category": "COMBINED",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Ouroboros – Fixed a bug in Flashback missions that caused Badges to be awarded only to the mission owner."
    },
    {
      "category": "COMBINED",
      "subsection": "Tailor",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Put back the Warrior lower body option from the Martial Arts pack, which had temporarily gone missing."
    },
    {
      "category": "COMBINED",
      "subsection": "Tailor",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug that made the left hand gun of female Thugs Masterminds (except the Legacy Semi-Auto) invisible."
    },
    {
      "category": "COMBINED",
      "subsection": "Tailor",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug for Male and Huge characters where the legacy tails still showed up in the Belt category if the upper body was set to Armored or Baggy."
    },
    {
      "category": "COMBINED",
      "subsection": "Global Email",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Increased the time before stored emails are deleted from 30 days to 60 days. There is now a column after the date that indicates how much longer an email will be stored."
    },
    {
      "category": "COMBINED",
      "subsection": "Global Email",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug that would cause attachments to be lost if an email was accidentally sent to an invalid name longer than 21 characters ."
    },
    {
      "category": "COMBINED",
      "subsection": "Arenas",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug that prevented players from issuing commands to Gladiators."
    },
    {
      "category": "COMBINED",
      "subsection": "Options",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed sound FX not playing properly when in flight and on Female and Huge models for various Costume Changes associated with the Mutant Pack"
    },
    {
      "category": "COMBINED",
      "subsection": "Options",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Players who have not prepurchased the Going Rogue expansion can now open The NCsoft Store Going Rogue prepurchase page at the Character Select screen at log in."
    },
