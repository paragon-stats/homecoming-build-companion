    {
      "category": "COMBINED",
      "subsection": "Tailor",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed an issue where some huge or female head accessories did not fit correctly."
    },
    {
      "category": "COMBINED",
      "subsection": "Tailor",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Removed Firefly and Snow Auras which were not intended for Issue 18. They will be available as part of Issue 19."
    },
    {
      "category": "COMBINED",
      "subsection": "Global Email",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug that would cause players to lose attachments if they tried to claim them while their inventory was full."
    },
    {
      "category": "COMBINED",
      "subsection": "Game Store",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed out of date links for Going Rogue Complete Collection."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Controllers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Mace Mastery – fixed availability of Focused Accuracy; the power was not unlocking properly."
    },
    {
