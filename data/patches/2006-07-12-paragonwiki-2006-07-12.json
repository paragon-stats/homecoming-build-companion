    {
      "category": "Combined",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Peacebringers in Lightform are no longer invisible to other players who have particle effects turned off."
    },
    {
      "category": "Combined",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Corrected Tooltip on Leadership/Tactics -- the right click help on the power icon did not list Fear resistance."
    },
    {
      "category": "Combined",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Added code to prevent the level adjustment of AVs/Heroes in Task Forces/Strike Forces based on Notoriety."
    },
    {
      "category": "Combined",
      "subsection": "City Zones",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Bloody Bay: Closed hole that allowed players to get below the Hero base."
    },
    {
      "category": "Combined",
      "subsection": "City Zones",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Pocket D: Fixed a bug that caused some players to get stuck in the elevator."
    },
    {
      "category": "Combined",
      "subsection": "Badges",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Added more female names to Badge Titles."
    },
    {
      "category": "Combined",
      "subsection": "Tailor",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Numerous small clipping issues fixed."
    },
    {
      "category": "Combined",
      "subsection": "Tailor",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed double listing of Chiton Armor for Female Bottoms."
    },
    {
      "category": "City of Heroes",
      "subsection": "Badges",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Troll Task Force badge now gives proper credit for time spent in the Hollows."
    },
    {
      "category": "City of Villains",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Manticore's Rain of Arrows has been toned down -- the power no longer multiplies the amount of damage by the number of targets hit."
    },
    {
      "category": "City of Villains",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Manticore has also regained his access to the emergency teleportation system -- a fact he uses to great benefit. (He should actually use his Teleportation power now.)"
    },
    {
      "category": "City of Villains",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "PPD Kheldians Incandescent Strike and buffing ability has been reduced somewhat. The buffs are approximately 40% of previous strength, and Incandescent Strike will now be used more often, but cause around 50% of previous damage."
    }
  ]
