    {
      "category": "COMBINED",
      "subsection": "General",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "More animation fixes:"
    },
    {
      "category": "COMBINED",
      "subsection": "General",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Added Shield (without weapons) and Claws/Pistols animations to Ninja Run."
    },
    {
      "category": "COMBINED",
      "subsection": "General",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Walk and Ninja Run are now properly interrupted by “sliding” animations."
    },
    {
      "category": "COMBINED",
      "subsection": "General",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Ninja Run animations are now properly interrupted by falls."
    },
    {
      "category": "COMBINED",
      "subsection": "General",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Players using the minimal Visual FX theme for Invulnerability powers will now have sound effects when activating Invulnerability toggles."
    },
    {
      "category": "COMBINED",
      "subsection": "Winter Event 2009",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Candy Cane reward for the Father Time mission will now grant if the player has full salvage."
    },
    {
      "category": "COMBINED",
      "subsection": "Winter Event 2009",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "NOTE: If you are in Lord Winter’s realm and the event timer runs out, you will be kicked back to Atlas Park (Heroes) or Mercy Island (Villains) rather than the zone you originally entered from."
    },
    {
      "category": "COMBINED",
      "subsection": "Winter Event 2009",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Known Issue : The Winter Lord does not spawn in Port Oakes or Mercy Island."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Atlas Park: The ‘Cape Mission’ given by the City Representative has been updated. The mission is also available through Flashback as the ‘Omega Team Time Capsule’ story arc."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Manticore Task Force - Fixed a bug in the first mission that was causing Paragon Protector Elites to spawn at too high a level."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "City Zones",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Grandville: The Merit Reward vendors have returned."
    }
