      "category": "COMBINED NOTES",
      "subsection": "Flashback",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Contact Stores now work in Task Force / Strike Force mode for contacts the player hasn't been introduced to in their 'real' lives."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Flashback",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Players who are already dead at the start of a Task Force/Flashback count towards the “deaths” total for that Task Force including for the purposes of the limited lives challenge."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Flashback",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Progress for ‘X Flashback missions completed’ badges will be awarded to all members of a group upon mission completion, not just the mission owner."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Game",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Improved Map Server stability."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Powers",
