      "powerset": "",
      "power": "",
      "text": "Any channel commands used by a Global Chat Operator will now be displayed in the channel, along with the name of the Operator using the command. This message will appear regardless of whether the Operator is hidden (i.e. if they are using /ghide)."
    },
