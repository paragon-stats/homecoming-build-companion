    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Accolades should now be available even when exemplared to lower levels."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed an issue with the “Rectified Reticle – Increased Perception” Invention Origin Enhancement that prevents characters from leveling up if the enhancement is slotted."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Graphical/Sound Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fire Melee Incinerate Graphical Effects will now hit the target after the appropriate delay."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Graphical/Sound Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Graphical Effects performance optimizations made for Fulcrum Shift and Heat Loss"
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Graphical/Sound Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed overly bright texture for Ouroboros Crystals when shader and water quality settings are not set to ‘high’"
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Graphical/Sound Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Damage numbers and hit Graphical Effects for Archery and Trick Arrow powers should sync up better with the Graphical Effects for the arrow projectiles."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Graphical/Sound Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Dominator Energy Assault - Power Bolt and Power Blast should be using their correct red tinted Graphical Effects again."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Graphical/Sound Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Graphical Effects for many critters using a copy of the “Burst” power should now visually line up with the animation."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Graphical/Sound Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Graphical Effects for Ice Bolt and Ice Blast have been reverted to their previous versions."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Graphical/Sound Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Tank/War Mace - Build Up will now only play the Graphical Effect and Sound Effect once."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Graphical/Sound Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Assault Rifle – Buckshot’s Sound Effect reverted to previous version."
    },
    {
