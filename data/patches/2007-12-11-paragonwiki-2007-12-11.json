    {
      "category": "CITY OF HEROES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Scrapper version of Heightened Senses’ Help text now matches the Help text of the other versions of the power."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Blasters"
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Defiance Replaced:"
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Blasters’ earliest abilities come so naturally to them, that they are accessible even in states that normally prevent them from using powers, such as being Held, Slept or Stunned."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Additionally, each time the Blaster attacks with a primary or secondary power, they gain a stacking damage bonus for the next several seconds. The amount of the damage bonus and its duration is dependent on the exact power used, with single target abilities generally giving the largest bonus."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Voltaic Sentinel now has a duration of 60 seconds for Blasters, and it should fly considerably faster."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "12.5 percent increase to Base Ranged Damage."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Defenders"
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Voltaic Sentinel should fly considerably faster for Defenders with Electric Blast."
    },
    {
