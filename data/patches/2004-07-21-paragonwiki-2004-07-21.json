      "category": "City Zones",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Terra Volta – fixed a location where a player could fall through the world."
    },
    {
      "category": "Missions",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed issue with certain Circle of Thorns maps where a player could fall through the world."
    },
    {
      "category": "Missions",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Adjusted villain spawns in prison rooms to keep them from trapping players in the cells."
    },
    {
      "category": "Missions",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Moved several Circle of Thorns crystals in mission maps to keep the player from being interrupted while trying to achieve a nearby objective."
    },
    {
      "category": "Powers",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Modified Giant Mushroom Monster attacks."
    },
    {
      "category": "Powers",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Modified Lightning Storm so it can be summoned in the Air, increased its fire rate and Range, and it now accepts Range Enhancements."
    },
    {
      "category": "Powers",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug when in certain situations removing a temporary power could deactivate auto powers for a short period."
    },
    {
      "category": "Powers",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug when in certain situations a summoned pet could turn evil."
    },
    {
      "category": "Graphics",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a graphics glitch that would cause a client crash in the Abandoned Sewer Network for certain hardware configurations."
    }
