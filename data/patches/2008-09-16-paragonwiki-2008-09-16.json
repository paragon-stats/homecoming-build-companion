    {
      "category": "COMBINED NOTES",
      "subsection": "Bases",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Corrected a rare case where Base rent became negative, and supergroups would be unable to pay rent. NOTE: It may take up to 24 hours after the build is published for rents to be corrected."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Global Chat",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Corrected an issue where Tabs changed what channels they contain when a character zones"
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Upped duration of taunt effects on Stone Control/Animate Stone from 1 second to 13.2 seconds."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Veteran Rewards",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "51 Month Veteran Badge will now correctly award the Pre-Order Blood Widow Helm. Please note that this helmet is only compatible with female models."
    }
  ]
