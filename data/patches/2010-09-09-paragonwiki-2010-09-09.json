    {
      "category": "COMBINED",
      "subsection": "Alignment System",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Using a respec or switching active builds will no longer bypass the 7 day wait to obtain Alignment powers."
    },
    {
      "category": "COMBINED",
      "subsection": "Alignment System",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Credit for Alignment powers will now be granted correctly to eligible team members of a Morality Mission who are sidekicked."
    },
    {
      "category": "COMBINED",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug in several missions in Paragon City, the Rogue Isles and Praetoria which could cause players to be hostile to each other."
    },
    {
      "category": "COMBINED",
      "subsection": "Email",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug that caused some players to be incorrectly flagged as having sent more than 150 emails in a day."
    },
    {
      "category": "COMBINED",
      "subsection": "Chat",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed crash when clicking the Friends button while in 10 or more chat channels."
    },
