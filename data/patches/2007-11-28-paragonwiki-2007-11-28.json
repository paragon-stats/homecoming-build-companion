    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Added “Assemble the Team”, the 42 month veteran reward power. This power works like Recall Friend, but affects the entire group at once and has a 30 minute cooldown."
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Adjusted Cast Times on Assault Rifle Burst/Slug for Blasters and for Corruptors."
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Reduced the cast time on Phase Shift"
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Changes to some Archery/Trick Arrow animation lengths and attack times (Most of the powers are now slightly quicker)"
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed many issues related to reduced archery animation times while flying."
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Adjusted Cast Times on Archery Snap Shot. It’s about 2/3rds of its previous value."
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Standardized cast time for powers using the Greater ____ Sword animation, including War Mace Shatter. Note that several critters will be attacking slightly faster with this power now."
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Corrected the combat message for Trick Arrow Disruption Arrow. It no longer incorrectly refers to the caster as being debuffed."
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Corrected Long Help Text on Blinding Flash. It no longer refers to itself as doing Moderate Damage in one place, and Light damage in another."
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Corrected short help text for the pool power Jump Kick."
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Telekinetic blast is now known as Telekinetic Blast."
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a typo in the text of the Galvanized effect."
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Build Up procs stack with the Build Up power"
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "IO’s which grant Knockback Protection stack with one another"
    },
    {
      "category": "POWERS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Signature Level ‘pets’ (friendly NPCs in missions) health and damage increased, and should all correctly display their Class now."
    },
    {
      "category": "SUPERGROUPS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "The Maximum membership of a supergroup has been increased from 75 to 150."
    },
    {
      "category": "SUPERGROUPS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "It is once again possible to create a supergroup starting with “The”."
    },
    {
      "category": "GRAPHIC EFFECTS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Wings, Weapons, and Costume Auras will now always show up with the option to suppress FX when close to the camera turned on."
    },
    {
      "category": "GRAPHIC EFFECTS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Energy Blast - Explosive Blast changed to better sync hit effects with projectile speed and impact time"
    },
    {
      "category": "GRAPHIC EFFECTS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Burned and Fairy wing costume pieces are now available with and without additional effects."
    },
    {
      "category": "GRAPHIC EFFECTS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Effects changes to the following powers to address performance concerns: Earth Control/Earthquake, Ice Control/ Chillblain, Ice Control Glacier"
    },
    {
      "category": "GRAPHIC EFFECTS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Graphical Effects used by many Temporary powers (mainly weapons) should never be suppressed by being close to the camera."
    },
    {
      "category": "GRAPHIC EFFECTS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Jump Jet Pack (From GvE Edition) will now inherit the alpha value from the player’s character model."
    },
    {
      "category": "GRAPHIC EFFECTS",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Graphical Effects for Dark Blast/Blackstar should play properly now."
    },
    {
      "category": "GAME",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Re-enabled renderthread by default on multi-cpu systems"
    },
    {
      "category": "GAME",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Modified size for trade window to allow 999,999,999 influence/infamy to be traded."
    },
    {
      "category": "GAME",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Changed tray power highlighting to show the highlight under other rings (e.g. the queued power dashed, red ring)."
    },
    {
      "category": "GAME",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "For Windows Vista users: Compatible cursors has been enabled by default"
    },
    {
      "category": "GAME",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Corrected an issue that could cause the mouse-over information to flicker when mousing over Enhancements"
    },
    {
      "category": "GAME",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Corrected a client crash for a situation that could arise when using the Consignment Market interface."
    },
    {
      "category": "GAME",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Check Name function on the Character Selection Screen: Corrected an issue where the Check Name feature would not find names that contain an apostrophe"
    },
    {
      "category": "ZONES",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Isaac the Bartender in Pocket D now correctly introduces himself as \"Isaac\""
    },
    {
      "category": "ZONES",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a hole in Bloody Bay geometry"
    },
    {
      "category": "ZONES",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Arena Map: Corrected a graphical issue with an Arena map where a floor type texture was sticking up into the sky."
    },
