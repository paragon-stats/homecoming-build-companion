    {
      "category": "COMBINED",
      "subsection": "Mission Architect",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug that was causing the damage done by certain allied critters to not affect rewards."
    },
    {
      "category": "COMBINED",
      "subsection": "Auction House",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed bug that was causing very large transactions to be miscalculated."
    },
    {
      "category": "COMBINED",
      "subsection": "Gameplay",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a crash that sometimes occurred when toggling 3 D Sound."
    },
    {
      "category": "COMBINED",
      "subsection": "Gameplay",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a crash when certain characters are included in the comment box while using the LFG system."
    },
    {
      "category": "COMBINED",
      "subsection": "Gameplay",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a crash when a player selected 'Back' during a respec."
    },
    {
      "category": "COMBINED",
      "subsection": "Gameplay",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed an issue that was causing input lag for some players."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a gap in the wall of the last mission of Positron's Task Force, Part 2."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Masterminds",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug that allowed Masterminds in some missions to Malefactor down and retain high level pets. Now pets will be lost whenever the combat level of the Mastermind's team decreases. This also resolves the issue of retaining 2 or 3 tier 1 pets while Malefactored down to the point where the Mastermind can only summon 1 pet."
    }
