    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a number of issues with the Super Booster I: Cyborg Self Destruct power:"
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Powers which change your character’s costume (Halloween Costumes, Granite Armor) are now immediately de-activated if you activate the Self Destruct power."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Self Destruction power should now reliably cause you to be defeated when it goes off."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fix for the never-ending camera shake that happens if you zone while the self-destruct power is counting down."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Removed extraneous blue dot from explosion F/X"
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Self Destruction power should correctly protect you from debt if you have other sources of Debt Protection."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed Self Destruction icon to indicate it is not a ranged attack power"
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fix for the issue of being defeated and self-rezzing during the countdown causing numerous character bugs"
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Cimerora: Fixed missing ocean in first mission of Imperious Task Force"
    }
  ]
