    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Rikti Drops Ships’ movement rate standardized. They are now completely immune to Slow movement effects."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Stealth powers should once again function in PvP zones. Good hunting."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "The Power of the Hamidon temporary power is now Deletable."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "All Rikti should be targettable after they die."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Borea Repeatable missions to defeat 10 enemies increased to defeat 50."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Rewards",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Characters who are below level 47 will not be able to select a Hamidon (or Synthetic Hamidon) Enhancement as a reward. They can choose anything else they qualify for from the reward choice table, however."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Rewards",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Rikti Monkeys in Invasions will now grant experience points when defeated."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Rewards",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Characters should only get reward credit for placing a bomb once per assault on the Rikti Mothership."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Rikti Invasions",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Rikti transporters now shield incoming invaders from attack until they have fully materialized."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Badges",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed numerous minor text and display errors with badges"
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Bases",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a crash when moving Slow Fields."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "User Interface",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed \"Suppress FX When Close\" option to work correctly, and to persist when a character logs/zones."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "User Interface",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed Check Name to no longer show names of characters that were recently deleted as unavailable."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Rewards",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Characters over level 40 cannot select the Multi-enhancement from the Eden Trial. Added SO Enhancements to the Eden trial choice dialog box."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Psionic Dart for Dominators’ endurance cost was set too high. It has been reduced to its correct value."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Graphical Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Added special case to Carrion Creepers effects to prevent it from incorrectly persisting after the power ends."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Graphical Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Dominator, Plant Control - Reduced particles for Vines and Carrion Creeper to optimize performance."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Graphical Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Minor optimizations to various power effects for Corruptor’s Cold Domination and Thermal Radiation to reduce their framerate performance impact"
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "City Zones",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "St. Martial: all stores in the zone should now buy salvage and recipes."
    }
  ]
