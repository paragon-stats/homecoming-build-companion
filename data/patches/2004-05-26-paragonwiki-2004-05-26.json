      "subsection": "City Zones:",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Unresponsive villains in the Circle of Thorns caves should defend their lairs again."
    },
    {
      "category": "5/26/04",
      "subsection": "Missions:",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Several Task Force Mission issues have been fixed."
    },
    {
      "category": "5/26/04",
      "subsection": "Missions:",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed some problems with higher-level Task Force story arcs."
    },
    {
      "category": "5/26/04",
      "subsection": "Missions:",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fix for a “ Mission ” map server crash occurring whenever a player had a mission map running and logged off from a City Zone."
    },
    {
