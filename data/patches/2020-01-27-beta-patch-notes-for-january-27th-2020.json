      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fix issue with AltGr causing the A key to clear text boxes."
    },
    {
      "category": "Powers",
      "subsection": "",
      "archetype": "Mastermind",
      "powerset": "Pain Domination",
      "power": "Painbringer",
      "text": "This power had a 1% chance of knocking down a buffed ally. This has been removed."
    },
    {
      "category": "Powers",
      "subsection": "",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Dual Pistols > Fixed a bug where Standard Ammo Only effects were applying under all Ammo types and Toxic Rounds would do nothing."
    },
