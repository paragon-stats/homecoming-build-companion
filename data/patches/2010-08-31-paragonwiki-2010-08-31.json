  "changes": [
    {
      "category": "COMBINED",
      "subsection": "Alignment System",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a crash whenever a Tourist became leader of a Task Force or Strike Force. Tourists can now accept and lead Task Forces and Strike Forces."
    },
    {
      "category": "COMBINED",
      "subsection": "Badges",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Added information to the Help Menu and a loading screen tip to explain that some badges are only granted to Heroes/Vigilantes or Villains/Rogues."
    },
    {
      "category": "COMBINED",
      "subsection": "Tailor",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "For Female characters, the Warrior Bottom piece from the Martial Arts pack is available again."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Controllers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Ice Mastery/Ice Blast - Corrected IO sets allowed. Now accepts Ranged Damage and Slow Movement."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Independence Port: Fixed a bug in Sister Psyche's 'Clamor and Destruction' arc that would sometimes tell players to go to a mission door in Precinct 5 (the Praetorian tutorial zone)."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Terra Volta: Fixed a bug in the Rikti version of the respec Trial that could cause a crash when the hostages were rescued."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Badges",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "The badge \"Surging\" is no longer 'Villain Only' and can be earned by Rogues in Paragon City. Vigilantes and Heroes who have already defeated Deathsurge will be granted this badge immediately."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Masterminds",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Chill Mastery - Fixed a bug which prevented you from taking additional powers in the set if you took Ice Blast as your first power."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Masterminds",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Heat Mastery/Char - Corrected IO sets allowed. Now accepts Ranged Damage and Holds."
    },
    {
      "category": "PRAETORIA",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug with all contacts introduced through Calvin Scott and Provost Marchand where players would have to click on the contact twice before they would give out missions. This affects the following contacts:"
