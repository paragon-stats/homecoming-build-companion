    {
      "category": "NEW MICRO-TRANSACTIONS",
      "subsection": "Team Transport",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Activate this power to summon a transport vehicle. Standing near the vehicle will teleport your team mates to the their active mission door.** Heroes, Vigilantes and Rogues in Paragon City will summon a Longbow Chaser"
    },
    {
      "category": "NEW MICRO-TRANSACTIONS",
      "subsection": "Team Transport",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Villains, Vigilantes and Rogues in the Rogue Isles will summon an Arachnos Flier"
    },
    {
      "category": "NEW MICRO-TRANSACTIONS",
      "subsection": "Team Transport",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Praetorians in Praetoria will summon a Praetorian Chaser"
    },
    {
      "category": "NEW MICRO-TRANSACTIONS",
      "subsection": "Team Transport",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "This power can be used once every 30 minutes"
    },
    {
      "category": "CHARACTER CREATION / TAILOR",
      "subsection": "General",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Archetype selection in character creation can no longer be deselected."
    },
    {
      "category": "CHARACTER CREATION / TAILOR",
      "subsection": "General",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "The VIP Tier 9 Fire and Ice costume sets are now included in the scrolling costume menu."
    },
    {
      "category": "POWERS",
      "subsection": "General",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug that was causing PPM enhancements to proc incorrectly."
    },
    {
      "category": "POWERS",
      "subsection": "General",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "A timing issue has been fixed with Peacebringer and Warshade costume change emotes"
    },
    {
      "category": "TASKS",
      "subsection": "Tin Mage Task Force",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Reward drops have been removed from Neuron's clones."
    },
    {
      "category": "TASKS",
      "subsection": "Imperious Task Force",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed an issue where Romulus Augustus Nictus was appearing in normal spawns."
    },
    {
      "category": "TASKS",
      "subsection": "Dream Doctor - Mission 3",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed an issue where Kheldians running the mission would not have all entities be removed from the ritual after the cutscene was completed."
    },
    {
      "category": "TASKS",
      "subsection": "Dream Doctor and Sister Solaris",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "When players choose to have a team of NPC allies in the final missions, the experience will be adjusted as follows:"
    },
    {
      "category": "TASKS",
      "subsection": "Dream Doctor and Sister Solaris",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Sister Solaris: Regular spawns of Talons will give 30% of their rewards. The remaining groups will give 50% of their rewards."
    },
    {
      "category": "TASKS",
      "subsection": "Dream Doctor and Sister Solaris",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Dream Doctor: Regular Banished Pantheon spawns will give 30% of their rewards. This does not effect any spawns after the, \"Defeat 200 Banished Pantheon\" portion."
    },
    {
      "category": "TASKS",
      "subsection": "Imperial City",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Jessica Flores's mission \"Rescue Jason and Kenneth\" can be completed once more."
    },
    {
      "category": "TASKS",
      "subsection": "Signature Story Arc 1: Episode 7",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed an issue where biographies were missing for tanks, Rula-Wade, and the Rularuu artifacts."
    },
    {
      "category": "TASKS",
      "subsection": "Cimerora",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Sister Airlia - Power from the Past Mission 2. Fixed an issue where the Longbow Ballista did not scale down to level 35."
    },
    {
      "category": "BADGES",
      "subsection": "General",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Mayhem and Safeguard mission badges now display progress bars for Rogues and Vigilantes."
    }
  ]
