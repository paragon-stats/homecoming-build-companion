    {
      "category": "COMBINED NOTES",
      "subsection": "Rikti Invasions",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Changed default channel for Rikti Invasion broadcast messages to System instead of Admin"
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "The Power of the Hamidon effect will be removed automatically if you are no longer on a Task Force."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Sounds changed for Sonic Resonance - Disruption field"
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Devouring Earth Lichen no longer give XP."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Infernal’s Altar has had its health reduced again."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Badges",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Heroes who get a Villain Mission badge (and Villains who get a Hero Mission badge) will have that badge immediately revoked. Characters who already have badges for missions that they should not be able to access due to which side they are on, will have those badges revoked as well."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Badges",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "The Villain Disruptor badge meter will display correctly again. No previous or current progress was lost."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Tailor",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Costume pieces awarded during the 2007 Valentine’s event are once again available to players that have earned them."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "User Interface",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Added a cancel button to the Check Name feature."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "User Interface",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Made an additional change to how the User Interface stores window opacity settings to ensure that any changes are saved correctly."
    },
    {
      "category": "CITY of HEROES",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed bug in 3rd respec trial that would sometimes send players to a mission door in the old Rikti Crash Site."
    }
  ]
