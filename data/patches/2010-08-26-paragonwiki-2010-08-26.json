    {
      "category": "COMBINED",
      "subsection": "Mission Architect",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed the animations for various custom critter powers that no longer matched the casting time after they became uninterruptible."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "City Zones",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Talos Island: fixed Crane parts that were missing textures."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Badges",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "The badge The Solution is no longer Hero Only and can be earned by Rogues in Paragon City. Rogues and Villains who have already defeated Jurassik will be granted this badge immediately."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Badges",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "The badge Spellbinding is no longer Hero Only and can be earned by Rogues in Paragon City. Rogues and Villains who have already defeated enough of the Cabal will be granted this badge immediately."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Morality Missions: The other selves in My Other Selves will no longer hang out with the player after their time is done."
    },
    {
      "category": "PRAETORIA",
      "subsection": "City Zones",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Neutropolis: Moved floating cargo containers down to the ground"
    },
    {
      "category": "PRAETORIA",
      "subsection": "City Zones",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Neutropolis: fixed Crane parts that were missing textures."
    },
    {
      "category": "PRAETORIA",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Neutropolis Underground - In Crow's first mission the waypoint now points directly at the VIP's location."
    },
    {
      "category": "PRAETORIA",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Neutropolis - Bobcat: Jon Shen's army of Syndicate initiates no longer show up all at once in an effort to outdo Reichsman and his 5th column troops. Their arrival is now staggered and paced throughout the mission rather than all lumped at the end."
    }
