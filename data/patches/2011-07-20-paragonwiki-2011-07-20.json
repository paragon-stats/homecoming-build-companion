    {
      "category": "COMBINED",
      "subsection": "Sound Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed an issue which was causing many ambient sounds to be muted"
    },
    {
      "category": "COMBINED",
      "subsection": "Sound Effects",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "The Neutropolis industrial zone is one area which should sound much livelier"
    },
    {
      "category": "COMBINED",
      "subsection": "League",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "The wait time to increase the size of an open league has been lowered from 5 minutes to 90 seconds."
    },
    {
      "category": "COMBINED",
      "subsection": "League",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "This is the time that players in an Open league have to wait for so more players have time to join before the Incarnate Trial starts."
    },
    {
      "category": "COMBINED",
      "subsection": "League",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "XP will now scale properly for leagues larger than 9 players."
    },
    {
      "category": "COMBINED",
      "subsection": "League",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "League leaders should now be able to invite players into a league while on an Incarnate Trial map"
    },
    {
      "category": "COMBINED",
      "subsection": "Incarnate Trial : Keyes Island Reactor",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Pets will no longer count against earning the Avoids the Green Stuff badge"
    },
    {
      "category": "COMBINED",
      "subsection": "Steampunk",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Huge: Sideburns should now blend properly with Steampunk Beard"
    },
    {
      "category": "COMBINED",
      "subsection": "Steampunk",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Female: Victorian Steampunk Bustier should no longer have clipping issues with tight and skin upper body"
