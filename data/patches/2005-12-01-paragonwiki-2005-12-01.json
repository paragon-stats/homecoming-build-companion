      "text": "1.3.2 Tasks"
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Game",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Improved game stability."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Game",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Safe Mode option now disables loading of user-overridden files, like downloaded map packs."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Game",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Closely packed map icons will now automatically separate for easier selection."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Powers that accept Endurance Modification Enhancements should no longer say they accept Endurance Recovery Enhancements. They now say they accept Endurance Modification Enhancements."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug with resistances for Circle of Thorn Frost Demons (Hordeling Lasher, Hordeling Hurler, Hordeling Berserker, Hellfrost, and Blade Prince). They are now resistant to cold and vulnerable to fire instead of the other way around."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Resistances for Caleb should now be similar to that of all Circle of Thorn Spectres (resistant to Smashing, Lethal, Toxic and Negative Energy but vulnerable to Energy and Psionic)."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed a bug with resistances for Deathsurge. Deathsurge should now be resistant to Energy."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Sonic Siphon should no longer flood the Combat page with messages."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "More tweaks for IR Goggles. They work properly now."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Thunder Clap no longer reports that it disabled toggles on PvE targets."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "City Zones",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Warburg: All characters in Safe Zones gain a high resistance to Confuse powers for as long as they remain in the Safe Zone."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "All placeable objects now have sound and increased brightness of pulse."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Cathedral of Pain - fixed Force Field power of final boss."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Cathedral of Pain - Encounter spawns near obelisks adjusted."
    },
    {
      "category": "COMBINED NOTES",
      "subsection": "Badges",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed Smasher Elite and Shivan gladiator badges."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Ice Armor/Energy Absorbtion allows the amount of endurance returned to be increased by Enhancements properly now."
    },
    {
      "category": "CITY OF HEROES",
      "subsection": "City Zones",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Outbreak: Updated Tutorial with more images."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Increased the effectiveness of Brute/Energy Aura powers (Kinetic Shield, Dampening Field, Power Shield, Energy Protection, and Energy Cloak)."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Powers",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Removed De-Toggle effect from Longbow Ballista and Wardens."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Villains who have used the respec granted by the first respec trial will now be properly granted the respec from the second trial."
    },
    {
      "category": "CITY OF VILLAINS",
      "subsection": "Tasks",
      "archetype": "",
      "powerset": "",
      "power": "",
      "text": "Fixed bug that sometimes prevented Brokers from introducing players to mid-to-high level Contacts."
    }
  ]
