dotnet_naming_style.s_camelcase.capitalization = camel_case


# --- StyleCop overrides (added as needs arose during bootstrap) ---
# PRE-1.0 SUPPRESSIONS: every rule disabled below must be re-evaluated before v1.0.
# Do not add to this list without
# a recorded reason.
[*.cs]
# No per-file copyright/license headers; terse. Decide permanence at v1.0.
dotnet_diagnostic.SA1633.severity = none
# XML doc analysis off pre-1.0 (no GenerateDocumentationFile yet); re-enable at v1.0.
dotnet_diagnostic.SA0001.severity = none
# Members not required to be documented pre-1.0 (consistent with SA0001); re-enable at v1.0.
dotnet_diagnostic.SA1600.severity = none

# --- Permanent convention alignments (not pre-1.0 items) ---
[*.cs]
# House convention is _camelCase private fields (naming rules above).
dotnet_diagnostic.SA1309.severity = none

# Explicit constructors are the codebase convention (every class with a
# constructor validates or does work in it); primary-constructor suggestions
# would fork the style for the simplest classes only.
dotnet_diagnostic.IDE0290.severity = none

# IDE0046 pushes returns into ternaries, which collides with the no-nested-ternaries rule
# the moment a second branch exists - the pair cannot
# both be satisfied, and the ternary rule has the readability argument.
dotnet_diagnostic.IDE0046.severity = none
# House convention omits `this.` qualification (IDE0003/naming rules make fields unambiguous).
dotnet_diagnostic.SA1101.severity = none

# Analyzer findings held at zero: each rule is raised to warning, which the build treats as an error.
[{src,tests}/**.cs]
dotnet_diagnostic.IDE0130.severity = warning

# --- SonarQube Cloud parity: SonarAnalyzer.CSharp severities, for all code, tests included ---
# Mirrors the SonarQube Cloud C# profile "Sonar way comprehensive": its 348 active rules are warnings, which the
# build treats as errors, and every other Sonar rule is off. Refresh from the profile's active rules
# (sonarcloud.io api/rules/search with the profile key, activation=true, languages=cs) and rewrite both lists.
[*.cs]
