# Super-Linter Shared Configuration
# Single source of truth for linter selection and non-path settings.
# Consumed by CI (.github/workflows/super-linter.yml).
#
# Adapted from kloehnwars-homelab (standalone-consumer model): only the
# Ansible selection is dropped (no automation/ tree in this repo). Checkov
# stays for GitHub Actions configuration checks; JSCPD stays for duplication
# control, with verbatim game data carved out in .github/linters/.jscpd.json.
#
# Keys MUST be alphabetically sorted (dotenv-linter enforces this).

# --- Linter config paths (relative, resolved by Super-Linter) and output ---
# LOG_LEVEL=NOTICE: a linter that passes prints one "Successfully linted" line;
# a linter that fails still prints its full output (errors are never silenced).
# NOTICE already hides the banner; SUPPRESS_POSSUM keeps it hidden when a run
# raises the level (SUPER_LINTER_LOG_LEVEL locally, debug logging in CI).
# The local runner reads this file too.
LINTER_RULES_PATH=.github/linters
LOG_LEVEL=NOTICE
MARKDOWN_CONFIG_FILE=.markdownlint.yml
PYTHON_RUFF_CONFIG_FILE=../../pyproject.toml
PYTHON_RUFF_FORMAT_CONFIG_FILE=../../pyproject.toml
SUPPRESS_POSSUM=true

# --- Linter selection (alphabetical) ---
VALIDATE_BASH=true
VALIDATE_BASH_EXEC=true
VALIDATE_CHECKOV=true
VALIDATE_EDITORCONFIG=true
VALIDATE_ENV=true
VALIDATE_GITHUB_ACTIONS=true
VALIDATE_GITHUB_ACTIONS_ZIZMOR=true
VALIDATE_GITLEAKS=true
VALIDATE_JSCPD=true
VALIDATE_JSON=true
VALIDATE_JSONC=true
VALIDATE_MARKDOWN=true
VALIDATE_POWERSHELL=true
VALIDATE_PYTHON_RUFF=true
VALIDATE_PYTHON_RUFF_FORMAT=true
VALIDATE_SHELL_SHFMT=true
VALIDATE_YAML=true
