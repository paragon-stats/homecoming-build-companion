<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Surface trim/AOT violations at build time, not at the post-merge publish. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Anthropic client's default base address; ANTHROPIC_BASE_URL and ask's base URL option replace it. -->
    <AssemblyMetadata Include="AnthropicBaseUrl" Value="https://api.anthropic.com" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

</Project>
