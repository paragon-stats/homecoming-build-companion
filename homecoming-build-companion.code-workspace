{
  "folders": [
    {
      "name": "homecoming-build-companion",
      "path": ".",
    },
    {
      "name": "MidsReborn (read-only reference)",
      "path": "../MidsReborn",
    },
  ],
  "settings": {
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 2,

    "files.associations": {
      "*.mhd": "binary",
      "*.mxd": "binary",
    },

    "files.exclude": {
      "**/scratch/build-archives": true,
    },

    "search.exclude": {
      "**/.venv": true,
      "**/scratch": true,
      "**/data/canonical/powers": true,
    },

    "markdownlint.config": {
      "MD013": false,
      "MD024": false,
      "MD033": false,
      "MD041": false,
    },

    "yaml.schemas": {
      "https://json.schemastore.org/github-workflow.json": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
      ],
    },

    "json.schemas": [
      {
        "fileMatch": ["build-format/samples/*.json", "samples/builds/*.json"],
        "url": "./build-format/schema.json",
      },
    ],

    "git.confirmSync": false,
    "git.autofetch": true,

    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#3b1f2b",
      "titleBar.activeForeground": "#fce4ec",
      "titleBar.inactiveBackground": "#2a161f",
      "titleBar.inactiveForeground": "#9c8590",
    },
    "powershell.cwd": "homecoming-build-companion",
  },
  "extensions": {
    "recommendations": [
      "tamasfe.even-better-toml",
      "redhat.vscode-yaml",
      "davidanson.vscode-markdownlint",
      "yzhang.markdown-all-in-one",
      "bierner.markdown-mermaid",
      "github.vscode-github-actions",
      "eamodio.gitlens",
      "gruntfuggly.todo-tree",
      "anthropic.claude-code",
      "ms-dotnettools.csharp",
      "ms-dotnettools.vscode-dotnet-runtime",
    ],
  },
}
