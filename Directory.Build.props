<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Every project restores from its committed packages.lock.json, which pins the indirect package versions too.
    CI sets CI=true, so every job that restores refuses a lock file that would change, with nothing to add per job.
    File-based scripts (dotnet run scripts/...) are left out: they would all share one lock file per folder.
    The binary job publishes with -r win-x64, which reaches every referenced project's restore, so every lock
    file carries that runtime as well, or a locked restore of the publish fails with NU1004.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile Condition="'$(FileBasedProgram)' != 'true'">true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers Condition="'$(FileBasedProgram)' != 'true'">win-x64</RuntimeIdentifiers>
    <RestoreLockedMode Condition="'$(CI)' == 'true' And '$(FileBasedProgram)' != 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>paragon-stats contributors</Authors>
    <Copyright>Copyright (c) 2026 paragon-stats contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    Version is derived from git tags by MinVer (tags look like v0.1.0). The release
    workflow owns the tags; MinVer stamps the assembly/file/AOT version. Between tags
    MinVer auto-increments the minor: the next dev build reads X.(Y+1).0-alpha.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <!-- The rules SonarQube Cloud applies, so they fail the local build first; severities in .editorconfig. -->
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <!-- StyleCop settings (usings outside namespaces). -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <!--
    PS0001, the in-repo minimum-identifier-length rule, loads into every other
    project's compile. It excludes itself, which would be circular.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'CohEngine.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\CohEngine.Analyzers\CohEngine.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
