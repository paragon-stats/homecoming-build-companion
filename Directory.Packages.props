<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.321" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <!-- Compiler API, for the in-repo PS0001 analyzer and its tests. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- Pinned ahead of the stages that reference them, so those stages do not edit this file. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.4.0" />
  </ItemGroup>
</Project>
